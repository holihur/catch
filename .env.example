# ---------------------------------------------------------------------------
# Catch API / single-binary deployment
# ---------------------------------------------------------------------------
APP_ENV=development
PORT=8080
# OTLP/gRPC 端口；设为 0 可关闭
GRPC_PORT=4317
# 生产环境默认要求 TLS；开发环境默认允许明文
# GRPC_TLS_CERT=/path/server.crt
# GRPC_TLS_KEY=/path/server.key
# 可选 mTLS：要求并校验客户端证书
# GRPC_TLS_CLIENT_CA=/path/client-ca.crt
# GRPC_ALLOW_INSECURE=true
# 指标告警评估间隔（秒）
ALERT_INTERVAL_SECONDS=30
# Go 同时托管前端时，PUBLIC_URL 与 APP_URL 保持一致
PUBLIC_URL=http://localhost:8080
APP_URL=http://localhost:8080
# 开发模式（Vite 5173）请使用：
# PUBLIC_URL=http://localhost:8091
# APP_URL=http://localhost:5173
# CORS_ORIGINS=http://localhost:5173,http://localhost:8091

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=catch
# 生产环境必须改为高强度随机值（会影响 OIDC secret 加密）
APP_SECRET=change-me-to-a-long-random-string
SESSION_TTL_HOURS=168
COOKIE_SECURE=false
ALLOW_DEV_LOGIN=true
SEED_DEMO=true
RETENTION_DAYS=30
INGEST_RATE_LIMIT=1200
LOG_LEVEL=info
# 必须包含浏览器访问 Catch 的 origin（含端口），公网访问时加入公网地址
CORS_ORIGINS=http://localhost:8080
# 可选：显式指定前端构建产物目录；不设置时自动探测
# STATIC_DIR=./frontend/dist

# ---------------------------------------------------------------------------
# 可选：启动时自动配置某个租户的 OIDC
# ---------------------------------------------------------------------------
# OIDC_TENANT_SLUG=acme
# OIDC_ISSUER=https://id.example.com/t/acme
# OIDC_CLIENT_ID=catch
# OIDC_CLIENT_SECRET=...
# OIDC_ALLOWED_DOMAINS=acme.com,acme.test
