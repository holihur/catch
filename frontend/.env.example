# Leave empty to use the Vite proxy (/api -> http://localhost:8091)
VITE_API_URL=
# Project ingest key used by the browser SDK. The demo seed uses this value.
# In production, create a project and paste its key here.
VITE_INGEST_KEY=ck_demo_web_0000000000000000000000
VITE_ENV=development
VITE_RELEASE=web@dev
VITE_APP_NAME=catch-web
